# Test environment configuration
# pytest loads it into the environment (env_files in pyproject.toml), where it takes precedence over .env, so the tests
# run with these values locally and in CI. The disposable PostgreSQL and OpenSearch replace the database URL and the
# OpenSearch host, which lead to no database or OpenSearch a test could change.
DEBUG=true
ENVIRONMENT=development

# Test Database URL
POSTGRES_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_db

# Test External Services
OPENSEARCH__HOST=http://localhost:9200
OLLAMA_HOST=http://localhost:11434
# Empty, so that no test reaches Jina AI with the key in .env. The tests fake Jina at its HTTP edge.
JINA_API_KEY=

# Test arXiv settings
ARXIV__MAX_RESULTS=15
