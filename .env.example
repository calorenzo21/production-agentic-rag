# `make setup` copies this file to .env and replaces every generated-by-make-setup value.
# Hostnames here are as seen from your machine. compose.yml sets the ones containers use.

# Application Settings
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
SERVICE_NAME=rag-api

# PostgreSQL Database Configuration
POSTGRES_SUPERUSER_PASSWORD=generated-by-make-setup
RAG_DB_PASSWORD=generated-by-make-setup
AIRFLOW_DB_PASSWORD=generated-by-make-setup
POSTGRES_DATABASE_URL=postgresql://rag_user:${RAG_DB_PASSWORD}@localhost:5432/rag_db
POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0

# OpenSearch Configuration
OPENSEARCH_ADMIN_PASSWORD=generated-by-make-setup
OPENSEARCH_DASHBOARDS_PASSWORD=generated-by-make-setup
OPENSEARCH_DASHBOARDS_COOKIE_PASSWORD=generated-by-make-setup
OPENSEARCH_APP_PASSWORD=generated-by-make-setup
OPENSEARCH_HOST=https://localhost:9200
OPENSEARCH_USERNAME=rag_app
OPENSEARCH_PASSWORD=${OPENSEARCH_APP_PASSWORD}
OPENSEARCH_CA_CERTS=secrets/opensearch/ca.crt

# Ollama Configuration (runs natively on the host)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=llama3.2:1b,gpt-oss:20b
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300

# Airflow Configuration
AIRFLOW_ADMIN_PASSWORD=generated-by-make-setup
AIRFLOW_FERNET_KEY=generated-by-make-setup
AIRFLOW_SECRET_KEY=generated-by-make-setup
