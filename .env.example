# `make setup` copies this file to .env and replaces every generated-by-make-setup value.
# Hostnames here are as seen from your machine. compose.yml sets the ones containers use.

# Application Settings
APP_VERSION=0.1.0
DEBUG=false
# development, staging or production. The settings refuse any other value
ENVIRONMENT=development
SERVICE_NAME=rag-api

# PostgreSQL Database Configuration
POSTGRES_SUPERUSER_PASSWORD=generated-by-make-setup
RAG_DB_PASSWORD=generated-by-make-setup
AIRFLOW_DB_PASSWORD=generated-by-make-setup
POSTGRES_DATABASE_URL=postgresql://rag_user:${RAG_DB_PASSWORD}@localhost:5432/rag_db
POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0

# OpenSearch Configuration
OPENSEARCH_ADMIN_PASSWORD=generated-by-make-setup
OPENSEARCH_DASHBOARDS_PASSWORD=generated-by-make-setup
OPENSEARCH_DASHBOARDS_COOKIE_PASSWORD=generated-by-make-setup
OPENSEARCH_APP_PASSWORD=generated-by-make-setup
OPENSEARCH__HOST=https://localhost:9200
# rag_app can only use the indices whose names start with arxiv-papers
OPENSEARCH__INDEX_NAME=arxiv-papers
# The chunk index's name is the index name followed by this suffix: arxiv-papers-chunks
OPENSEARCH__CHUNK_INDEX_SUFFIX=chunks
# The dimension and space type of the Chunks' vectors (cosinesimil, l2 or innerproduct). make reindex applies a change
OPENSEARCH__VECTOR_DIMENSION=1024
OPENSEARCH__VECTOR_SPACE_TYPE=cosinesimil
# The search pipeline that fuses a Search by words and by meaning with Reciprocal Rank Fusion. The API creates it at
# startup when it is missing, as the DAG's setup does, and make reindex creates it again
OPENSEARCH__RRF_PIPELINE_NAME=hybrid-rrf-pipeline
# Each half of a Search by words and meaning keeps this many times the largest page, 100, of the best Chunks, the same on
# every page, and the Search reaches only their Papers. From 1 to 50, as the Search asks OpenSearch for twice as many
# Chunks, and OpenSearch returns at most 10,000 at once
OPENSEARCH__HYBRID_SEARCH_SIZE_MULTIPLIER=2
# The application logs in as rag_app, with OPENSEARCH_APP_PASSWORD
OPENSEARCH__USERNAME=rag_app
OPENSEARCH__PASSWORD=${OPENSEARCH_APP_PASSWORD}
OPENSEARCH__CA_CERTS=secrets/opensearch/ca.crt

# Text Chunking Configuration, for the indexing that Airflow and make reindex run
# A section under 100 words is combined with its neighbours and one of 100 to 800 words is one Chunk. A longer one, or
# a Content without sections, is split into windows of CHUNKING__CHUNK_SIZE words that overlap by CHUNKING__OVERLAP_SIZE
CHUNKING__CHUNK_SIZE=600
CHUNKING__OVERLAP_SIZE=100
# The fewest words a text needs to be split into windows of CHUNKING__CHUNK_SIZE
CHUNKING__MIN_CHUNK_SIZE=100
# false chunks a Paper's Content into plain word windows, without its sections
CHUNKING__SECTION_BASED=true

# Jina AI Configuration, for the embeddings. Only the API and Airflow receive it
# make setup cannot generate it: replace this placeholder with your key from https://jina.ai/embeddings/
JINA_API_KEY=your_jina_api_key_here

# Ollama Configuration (runs natively on the host)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300

# arXiv API Configuration, for the Ingestion that Airflow runs
ARXIV__BASE_URL=https://export.arxiv.org/api/query
ARXIV__PDF_CACHE_DIR=./data/arxiv_pdfs
# The delay and the timeout apply to every request to arXiv, PDF downloads included
ARXIV__RATE_LIMIT_DELAY=3.0
ARXIV__TIMEOUT_SECONDS=30
# Papers per day, newest first. The course's Week 3 lowers it to 15, without a reason. 5 is a Deviation, to spend few
# Jina tokens: indexing embeds every Chunk, about 20,000 tokens for a Paper with Content and a few hundred for one
# without, so 100 Papers embed about 800,000 when 4 in 10 have Content, as on 2026-11-27, and 1.5 million at 3 in 4.
# On the maintainer's Mac, with a page limit of 20, a run took about 17 seconds per Paper, so about 30 minutes for 100:
# Docling parsed a PDF in about 22, and the parser skipped the PDFs over the limit, about 40%, before Docling saw them.
# With a page limit of 30, the run that ingested 2026-11-20 took about 19 seconds per Paper, so 31 minutes for 100:
# Docling parsed a PDF in a median of 18, 25 on average, and the parser skipped the PDFs over the limit, 22 of 96 or
# about 23%. So a weekday's whole listing, over 200 Papers, would take more than an hour.
ARXIV__MAX_RESULTS=5
ARXIV__SEARCH_CATEGORY=cs.AI
# Attempts at each PDF download, the first one included. The nth retry waits n times the delay, in seconds
ARXIV__DOWNLOAD_MAX_RETRIES=3
ARXIV__DOWNLOAD_RETRY_DELAY_BASE=5.0
# PDFs downloading at once, their requests still a rate limit delay apart, and PDFs parsing at once
ARXIV__MAX_CONCURRENT_DOWNLOADS=5
ARXIV__MAX_CONCURRENT_PARSING=1

# PDF Parser Configuration, for the Ingestion that Airflow runs
# Limit pages to prevent memory issues with large papers
PDF_PARSER__MAX_PAGES=30
# A PDF download stops as soon as it exceeds this size
PDF_PARSER__MAX_FILE_SIZE_MB=20
# OCR is very slow, disable for speed
PDF_PARSER__DO_OCR=false
PDF_PARSER__DO_TABLE_STRUCTURE=true

# Airflow Configuration
AIRFLOW_ADMIN_PASSWORD=generated-by-make-setup
AIRFLOW_FERNET_KEY=generated-by-make-setup
AIRFLOW_SECRET_KEY=generated-by-make-setup
AIRFLOW_JWT_SECRET=generated-by-make-setup
