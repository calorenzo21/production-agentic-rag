# Throwaway credentials for development mode only. Production mode generates its own secrets.

# PostgreSQL
POSTGRES_PASSWORD=dev-superuser-password
POSTGRES__PASSWORD=dev-curator-password
AIRFLOW_DB_PASSWORD=dev-airflow-password

# OpenSearch runs without security in development mode, so it ignores this password.
OPENSEARCH__PASSWORD=dev-opensearch-password

# Airflow
AIRFLOW_ADMIN_PASSWORD=dev-admin-password
AIRFLOW_FERNET_KEY=ZGV2LW9ubHktZmVybmV0LWtleS0wMTIzNDU2Nzg5YWI=
AIRFLOW_JWT_SECRET=dev-only-jwt-secret-that-is-long-enough-for-hs512-signing-0123456789
AIRFLOW_API_SECRET_KEY=dev-only-api-secret-key

# Ollama runs natively on the host. Change this to reach it on another machine.
OLLAMA__URL=http://host.docker.internal:11434
